# Gemini settings for the agents. Copy this file to agents/.env and fill it in:
#   Copy-Item agents\.env.example agents\.env      (PowerShell)
#   cp agents/.env.example agents/.env             (bash)
# agents/.env is git-ignored: the real key never goes to GitHub.

# FALSE = Gemini API with an API key (below); TRUE = Vertex AI with your gcloud credentials
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key

# Optional: more free models to fall back on when Gemini is busy or out of quota.
# Each provider is used only when its key is set; leave the ones you don't have empty.
#   Groq        https://console.groq.com/keys
#   Cerebras    https://cloud.cerebras.ai  (API Keys)
#   Mistral     https://console.mistral.ai/api-keys  (free "Experiment" plan)
#   OpenRouter  https://openrouter.ai/keys  (models ending in ":free")
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
