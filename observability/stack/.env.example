# Secrets for the local observability stack. Copy this file to observability/stack/.env and fill it in.
# observability/stack/.env is git-ignored; docker compose reads it automatically.

# Only needed for the Cloud Run add-on (docker-compose.cloud.yml): the token the Cloud Run services
# must send to the public telemetry endpoint. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TELEMETRY_TOKEN=replace-with-a-long-random-hex-string
