# OpenTelemetry settings for "Cloud Trace only" mode (Google Cloud, no Docker), loaded with:
#   uv run --env-file gcp.env ...
# Every service sends traces, logs and metrics straight to Google Cloud
# (telemetry.googleapis.com): Cloud Trace, Cloud Logging and Cloud Monitoring.
# The orchestrator and A2A agents also need --otel_to_cloud (see README).
# The project comes from GOOGLE_CLOUD_PROJECT (set automatically in Cloud Shell).

OTEL_TO_GCP=true

# Cloud Logging log name for every service's logs
GCP_DEFAULT_LOG_NAME=diet-planner

# Metrics to Cloud Monitoring; set to false if your project doesn't allow it (no billing)
OTEL_GCP_METRICS=true

# The A2A SDK's own spans (~150 internal queue spans per request) would hide the real flow
# in Cloud Trace; the HTTP and agent spans of the A2A calls are kept.
OTEL_INSTRUMENTATION_A2A_SDK_ENABLED=false

# Same as otel.env: readable traces, current HTTP metric names, one service namespace
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=dev-ui,list-apps,favicon,builder,debug,apps/.*/users/.*/sessions$
OTEL_SEMCONV_STABILITY_OPT_IN=http
OTEL_RESOURCE_ATTRIBUTES=service.namespace=diet-planner
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BLRP_SCHEDULE_DELAY=1000
