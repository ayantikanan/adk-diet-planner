# OpenTelemetry settings, loaded with:  uv run --env-file otel.env ...
# Standard OTel env vars: ADK, the MCP server and the A2A agents all read them.

# Where to send traces, metrics and logs (the local collector in observability/collector.py)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Export quickly so traces show up within ~1 second, metrics every 10 seconds
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BLRP_SCHEDULE_DELAY=1000
OTEL_METRIC_EXPORT_INTERVAL=10000

# Don't trace the web UI's own page/asset requests (keeps traces readable)
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=dev-ui,list-apps,favicon,builder,debug,apps/.*/users/.*/sessions$

# Use the current HTTP metric names (http.server.request.duration, in seconds)
OTEL_SEMCONV_STABILITY_OPT_IN=http

# Groups all services together in Grafana (service_namespace label)
OTEL_RESOURCE_ATTRIBUTES=service.namespace=diet-planner
